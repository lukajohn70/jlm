# JLM Apache Configuration & 404 Fallback
RewriteEngine On

# ── Local vs Production base directory ────────────────────────────────────
# Local MAMP:       RewriteBase /jlm/
# Live (jlm.com.ng): RewriteBase /
# ──────────────────────────────────────────────────────────────────────────
RewriteBase /jlm/

# Standard Apache ErrorDocument fallback (redirects to 404.php on strict Apache errors)
ErrorDocument 404 404.php

# Dynamic URL Rewriter fallback (keeps the original URL in the browser bar while rendering the 404 page)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . 404.php [L]
